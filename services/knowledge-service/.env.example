PORT=3002
DATABASE_URL=postgresql://app_user:app_pass@localhost:5432/app_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=your-super-secret-jwt-key-change-me
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_METADATA_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=64
# Redis embedding cache (skip re-embedding identical chunk text)
REDIS_URL=redis://localhost:6379
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SEC=2592000
METADATA_BATCH_SIZE=5
MAX_UPLOAD_SIZE_MB=10
HNSW_EF_SEARCH=100
LOG_LEVEL=info
NODE_ENV=development

# Retrieval: load chunk metadata catalog, LLM picks matching values, pgvector search
METADATA_QUERY_EXTRACTION_ENABLED=true
METADATA_QUERY_MODEL=gpt-4o-mini
METADATA_CATALOG_LIMIT=200
