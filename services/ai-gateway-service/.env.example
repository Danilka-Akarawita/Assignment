PORT=3004
DATABASE_URL=postgresql://app_user:app_pass@localhost:5432/app_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=your-super-secret-jwt-key-change-me

# Required for /conversations/:id/messages (ADK agents use Gemini)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=key

GPT_MODEL=gpt-5.4-nano-2026-03-17
GEMINI_MODEL=gemini-3.1-flash-lite
TOOL_EXECUTION_SERVICE_URL=http://localhost:3003
KNOWLEDGE_SERVICE_URL=http://localhost:3002
LOG_LEVEL=info
NODE_ENV=development
ADK_APP_NAME=ai-gateway

# Langfuse observability (LLM + agent traces)
# https://cloud.langfuse.com — create project → API keys
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# ADK guardrails + LLM answer judge (uses Gemini)
GUARDRAIL_JUDGE_ENABLED=true
GUARDRAIL_JUDGE_MODEL=gemini-3.1-flash-lite
GUARDRAIL_MIN_SCORE=0.6
GUARDRAIL_BLOCK_ON_FAIL=false
GUARDRAIL_APPEND_WARNING=false

# API rate limits (429 if exceeded). Polling uses GET /agent-runs — keep read limit high.
# Set RATE_LIMIT_ENABLED=false for local dev if you still hit 429 while testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_WRITE_MAX=60
