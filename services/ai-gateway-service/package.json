{
  "name": "ai-gateway-service",
  "version": "1.0.0",
  "description": "AI Gateway: chat orchestration, ADK agents, RAG and tool chaining",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../../packages/shared && prisma generate",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "prestart": "npm run build --prefix ../../packages/shared && npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test tests/gateway.test.ts tests/agent-run-hub.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@ai-assistant/shared": "file:../../packages/shared",
    "@google/adk": "^0.2.0",
    "@google/genai": "^1.0.0",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
