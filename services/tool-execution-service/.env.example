PORT=3003
DATABASE_URL=postgresql://app_user:app_pass@localhost:5432/app_db
JWT_SECRET=your-super-secret-jwt-key-change-me
KNOWLEDGE_SERVICE_URL=http://localhost:3002
LOG_LEVEL=info
NODE_ENV=development

# SQL tool safeguards
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=500
SQL_ALLOWED_SCHEMAS=public
SQL_GENERATOR_MAX_RETRIES=1

# SQL generator (OpenAI via AI SDK) — required for sql tool
OPENAI_API_KEY=
SQL_GENERATOR_MODEL=gpt-4.1-mini
